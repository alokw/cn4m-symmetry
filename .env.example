# --- cn4m-symmetry configuration ---------------------------------------------
# Copy to .env and edit:  cp .env.example .env
# Only .env is read at runtime - edits to this example file have no effect.
#
# NEVER put quotes around a Windows path. Backslash escapes are expanded inside
# double quotes, so TARGET_DIR="M:\test" silently becomes M:<TAB>est. Write it
# unquoted (M:\test) or use forward slashes (M:/test), which also work fine.
#
# TARGET_DIR is created automatically if it does not exist, parents included.

# These two paths are interpreted BY THE PROCESS, so they depend on where you
# run it. Pick one style and stay consistent:
#
#   Running in Docker  -> use CONTAINER paths, and bind-mount the real folder
#                         onto /data in docker-compose.yml. A Windows path like
#                         M:/test does not exist inside the container.
#                           SOURCE_DIR=/data/test
#                           TARGET_DIR=/data/test_target
#                           HOST_DATA_DIR=M:/          (mounted at /data)
#
#   Running on Windows -> use real Windows paths, unquoted:
#     directly              SOURCE_DIR=M:/test
#     (python symmetry.py)  TARGET_DIR=M:/test_target

# Folder to scan.
SOURCE_DIR=/data/source

# Folder that receives the mirrored structure of links.
TARGET_DIR=/data/target

# Seconds between scans.
SCAN_INTERVAL=60

# hard    = hard links, zero extra disk usage, SAME filesystem/mount only
# symlink = symbolic links, works across filesystems, breaks if source moves
LINK_MODE=hard

# Remove links in TARGET_DIR whose source file no longer exists.
PRUNE=true

# Include dotfiles / dot-directories.
INCLUDE_HIDDEN=true

# Comma-separated glob patterns to skip. Matched against the file/dir name and
# against the path relative to SOURCE_DIR.
# e.g. EXCLUDE_PATTERNS=*.tmp,*.partial,.git,@eaDir,cache/*
EXCLUDE_PATTERNS=

# Log everything that would happen without touching the filesystem.
DRY_RUN=false

# Name of the parent utility's asset manifest, looked for in TARGET_DIR. Any
# asset listed under untracked_quar_assets or tracked_quar_assets is kept out
# of the mirror, and removed from TARGET_DIR if it was linked earlier. The
# source file is never touched. Set empty to disable the check entirely.
QUARANTINE_FILE=assets.json

# Skip files that are still being written. A file is only linked once its size
# AND mtime have stayed identical for this many seconds, checked across scans -
# so a new or changed file is normally linked one scan after it stops growing.
# Both are compared because sync clients (Dropbox included) keep a file's
# original timestamp while its data is still arriving, which makes mtime alone
# unreliable. Set 0 to link immediately without waiting.
STABLE_SECONDS=60

# Honour deletions you make in the target: a file or folder you remove is
# remembered and never pushed again, so the mirror is a one-time push per file
# rather than a continuous re-sync. Deleting a link never touches the source.
# Put a file or folder back by hand and it is managed again from then on; to
# re-push everything, delete the state file from TARGET_DIR.
RESPECT_DELETIONS=true

# Where to keep that memory. Empty means .symmetry-state.json inside TARGET_DIR,
# which is usually what you want - it travels with the mirror, and deleting the
# whole target resets cleanly. Point it somewhere else to keep the bookkeeping
# out of the mirrored folder.
STATE_FILE=

# Push a short status line to cn4m whenever a scan links new files. Empty
# disables it entirely; nothing is ever sent for a scan that changed nothing.
# Equivalent to:
#   curl -X POST http://<cn4m-host>:2640/suite/status \
#        -d app=symmetry -d message="Synced 40 links" -d level=working
# Sending happens on a background thread and swallows its errors, so an
# unreachable cn4m never delays or interrupts mirroring.
# In Docker, localhost is this container - see the note above; use
# host.docker.internal for cn4m on the Docker host, or its service name if it
# is another container. Empty disables status pushes entirely.
STATUS_URL=http://localhost:2640/suite/status
STATUS_APP=symmetry
STATUS_LEVEL=working
STATUS_TIMEOUT=5

# Read-only status page: configuration, disk usage split between space shared
# with the source and space genuinely consumed, and a log of recent scans.
# Reachable at http://localhost:2647/ with the compose port mapping below.
# It has no authentication, so only expose it on a network you trust.
WEB_ENABLED=true
WEB_PORT=2647

# Let the status page queue a force push for files you deleted from the target.
# This is the only thing on the page that changes anything, and all it can do is
# forget a remembered deletion so the file gets linked again - it never deletes
# or overwrites. Set false to keep the page strictly read-only.
WEB_ALLOW_ACTIONS=true

# Webhook: POST (or GET) /api/rescan starts a scan right away instead of
# waiting for the next interval - for a file watcher to call when it knows a
# file has finished arriving. Pass the path(s) and they skip the settle wait:
#   curl -X POST http://localhost:2647/api/rescan -d path=1100/new_asset.mov
# Without paths it is a plain early scan and STABLE_SECONDS still applies.
# Set a token and callers must send it (X-Webhook-Token header, Bearer, or
# ?token=); it then guards the force-push endpoint too. Empty means open.
WEBHOOK_TOKEN=

# Seconds to wait after a webhook before scanning, so a burst of callbacks
# from a watcher becomes one scan rather than one per file. 0 disables.
WEBHOOK_DEBOUNCE=1

# Most files to list on the status page. Problem rows (deleted, errored, still
# arriving, quarantined) are listed first, so a big tree never hides them.
WEB_MAX_FILES=5000

# Run a single scan and exit (useful for cron or a one-off check).
RUN_ONCE=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- host paths, used by docker-compose.yml -----------------------------------
# Mounted at /data in the container. Set this to the closest directory that
# CONTAINS BOTH your source and target folders, then point SOURCE_DIR and
# TARGET_DIR at subfolders of /data. e.g. with HOST_DATA_DIR=/mnt/pool:
#   SOURCE_DIR=/data/media/tv
#   TARGET_DIR=/data/apps/jellyfin/library
# Hard links cannot cross mount points, so two separate volume mappings fail
# with EXDEV even when both folders are on the same disk. One mount, always.
HOST_DATA_DIR=/mnt/pool
