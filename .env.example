# --- cn4m-symmetry configuration ---------------------------------------------
# Copy to .env and edit:  cp .env.example .env
# Only .env is read at runtime - edits to this example file have no effect.
#
# NEVER put quotes around a Windows path. Backslash escapes are expanded inside
# double quotes, so TARGET_DIR="M:\test" silently becomes M:<TAB>est. Write it
# unquoted (M:\test) or use forward slashes (M:/test), which also work fine.
#
# TARGET_DIR is created automatically if it does not exist, parents included.

# These two paths are interpreted BY THE PROCESS, so they depend on where you
# run it. Pick one style and stay consistent:
#
#   Running in Docker  -> use CONTAINER paths, and bind-mount the real folder
#                         onto /data in docker-compose.yml. A Windows path like
#                         M:/test does not exist inside the container.
#                           SOURCE_DIR=/data/test
#                           TARGET_DIR=/data/test_target
#                           HOST_DATA_DIR=M:/          (mounted at /data)
#
#   Running on Windows -> use real Windows paths, unquoted:
#     directly              SOURCE_DIR=M:/test
#     (python symmetry.py)  TARGET_DIR=M:/test_target

# Folder to scan.
SOURCE_DIR=/data/source

# Folder that receives the mirrored structure of links.
TARGET_DIR=/data/target

# Seconds between scans.
SCAN_INTERVAL=60

# hard    = hard links, zero extra disk usage, SAME filesystem/mount only
# symlink = symbolic links, works across filesystems, breaks if source moves
LINK_MODE=hard

# Remove links in TARGET_DIR whose source file no longer exists.
PRUNE=true

# Include dotfiles / dot-directories.
INCLUDE_HIDDEN=true

# Comma-separated glob patterns to skip. Matched against the file/dir name and
# against the path relative to SOURCE_DIR.
# e.g. EXCLUDE_PATTERNS=*.tmp,*.partial,.git,@eaDir,cache/*
EXCLUDE_PATTERNS=

# Log everything that would happen without touching the filesystem.
DRY_RUN=false

# Name of the parent utility's asset manifest, looked for in TARGET_DIR. Any
# asset listed under untracked_quar_assets or tracked_quar_assets is kept out
# of the mirror, and removed from TARGET_DIR if it was linked earlier. The
# source file is never touched. Set empty to disable the check entirely.
QUARANTINE_FILE=assets.json

# Skip files that are still being written. A file is only linked once its size
# AND mtime have stayed identical for this many seconds, checked across scans -
# so a new or changed file is normally linked one scan after it stops growing.
# Both are compared because sync clients (Dropbox included) keep a file's
# original timestamp while its data is still arriving, which makes mtime alone
# unreliable. Set 0 to link immediately without waiting.
STABLE_SECONDS=60

# Run a single scan and exit (useful for cron or a one-off check).
RUN_ONCE=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- host paths, used by docker-compose.yml -----------------------------------
# Mounted at /data in the container. Set this to the closest directory that
# CONTAINS BOTH your source and target folders, then point SOURCE_DIR and
# TARGET_DIR at subfolders of /data. e.g. with HOST_DATA_DIR=/mnt/pool:
#   SOURCE_DIR=/data/media/tv
#   TARGET_DIR=/data/apps/jellyfin/library
# Hard links cannot cross mount points, so two separate volume mappings fail
# with EXDEV even when both folders are on the same disk. One mount, always.
HOST_DATA_DIR=/mnt/pool
